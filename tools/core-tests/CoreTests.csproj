<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles HarborWatch.Core and its Unity EditMode tests outside Unity and
       runs them with a tiny NUnit-compatible shim (no NuGet needed):
         dotnet run, project tools/core-tests
       Inside Unity the same test file runs under the real NUnit Test Runner. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/HarborWatch/Assets/HarborWatch/Core/**/*.cs" />
    <Compile Include="../../unity/HarborWatch/Assets/HarborWatch/Tests/Editor/**/*.cs" />
    <Compile Include="NUnitShim.cs" />
  </ItemGroup>
</Project>
